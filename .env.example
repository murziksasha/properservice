# ProperService environment

# Required: admin login password (use a strong value in production)
ADMIN_PASSWORD=changeme

# Required in production: secret for signing session cookies
# Generate: openssl rand -hex 32
SESSION_SECRET=replace-with-long-random-string

# Cookie Secure flag. false for local HTTP (Docker on localhost). true only with HTTPS.
COOKIE_SECURE=false

# Data
# DATA_DIR=/absolute/path/to/data   # optional, for docker volume

# Mailer (Next.js /api/contact; also used by legacy PHP mailer if enabled)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-app-password   # For Gmail use 16-char App Password
MAIL_TO=remontmailshop@gmail.com
MAIL_FROM=your-email@gmail.com

# Docker (optional)
NGINX_PORT=80
