# ProperService environment
ADMIN_PASSWORD=changeme

# Data
# DATA_DIR=/absolute/path/to/data   # optional, for docker volume

# Mailer (used by Next.js /api/contact and the legacy PHP mailer)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-app-password   # For Gmail use 16-char App Password (not regular password)
MAIL_TO=remontmailshop@gmail.com
MAIL_FROM=your-email@gmail.com

# For docker (optional overrides)
NGINX_PORT=80
