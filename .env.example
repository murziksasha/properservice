# ProperService environment

# Required: admin login password (use a strong value in production)
ADMIN_PASSWORD=changeme

# Required in production: secret for signing session cookies
# Generate: openssl rand -hex 32
SESSION_SECRET=replace-with-long-random-string

# Cookie Secure flag.
# false = HTTP (localhost, Docker, Keen DNS / LAN without TLS) — required or admin login cookies won't stick.
# true  = only when the site is served over HTTPS.
COOKIE_SECURE=false

# Optional: restrict admin UI + admin APIs (auth/site/upload/backup/leads/media) to listed IPs.
# Leave empty to allow any IP (password still required). Example:
# ADMIN_IP_ALLOWLIST=192.168.1.10,127.0.0.1,::1
ADMIN_IP_ALLOWLIST=

# Auto snapshot on each content save → data/backups/ (set false to disable)
AUTO_BACKUP=true
# How many rolling backups to keep
BACKUP_KEEP=20
# Optional secret for cron: POST /api/backup with Authorization: Bearer <secret>
# BACKUP_CRON_SECRET=replace-with-long-random

# Contact leads journal → data/leads.json (always written on form submit)
# Max ~500 newest entries kept automatically.

# Data
# DATA_DIR=/absolute/path/to/data   # optional, for docker volume
# Off-site: copy DATA_DIR + public/uploads to another disk/SMB/rclone weekly.

# Mailer (Next.js /api/contact; also used by legacy PHP mailer if enabled)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-app-password   # For Gmail use 16-char App Password
MAIL_TO=remontmailshop@gmail.com
MAIL_FROM=your-email@gmail.com

# Public site URL (for sitemap.xml absolute links, Open Graph metadataBase)
# Example: http://properservice.local  or  https://your-domain.com
# SITE_URL=http://localhost

# GinCore widgets on public pages (default on). Set false to disable.
# GINCORE_WIDGETS=false

# Docker (optional)
# Bind nginx to all interfaces so Keenetic DNS / LAN clients can reach the laptop:
NGINX_PORT=80
# Example: open firewall for TCP 80, set Keen DNS A-record to this machine's LAN IP.
